# Server-only settings: never prefix with NEXT_PUBLIC_. Copy to .env.local and fill in.

# Headless CMS. See docs/cms/client-website.md.
HEADLESS_CMS_API_URL=
HEADLESS_CMS_API_KEY=
HEADLESS_CMS_WEBHOOK_SECRET=

# EmailJS, used by the contact form (src/app/_lib/sendContactMessage.js). The account must allow
# "API for non-browser applications", since the message is sent from the server.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# Buttondown, used by the newsletter signup form (src/app/_lib/subscribeToNewsletter.js).
BUTTONDOWN_API_KEY=
