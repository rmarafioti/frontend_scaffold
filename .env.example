# Server-only settings: never prefix with NEXT_PUBLIC_. Copy to .env.local and fill in.

# Headless CMS. See docs/cms/client-website.md. The contact form sends through the CMS with the
# same URL and key (docs/cms/contact.md).
HEADLESS_CMS_API_URL=
HEADLESS_CMS_API_KEY=
HEADLESS_CMS_WEBHOOK_SECRET=

# Buttondown, used by the newsletter signup form (src/app/_lib/subscribeToNewsletter.js).
BUTTONDOWN_API_KEY=
